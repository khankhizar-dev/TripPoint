<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.TripPoint" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#F8FAFC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and animation duration. -->
        <item name="windowSplashScreenBackground">#F8FAFC</item>

        <!-- Hide the icon to prevent double splash effect since we have a custom Compose splash -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>

        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <item name="postSplashScreenTheme">@style/Theme.TripPoint</item>
    </style>
</resources>
